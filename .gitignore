# ==========================================
# 1. Virtual Environment (파이썬 가상환경)
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# 2. Python Cache & Build (캐시 및 빌드 파일)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 3. Environment Variables (보안 sensitive 정보)
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# 4. IDE / Editor Settings (에디터 설정 파일)
# ==========================================
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# 5. OS Generated Files (운영체제 임시 파일)
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# 6. Logs & Databases (로그 및 데이터베이스)
# ==========================================
*.log
*.sqlite3